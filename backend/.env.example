# NyayAPP Backend Environment Variables
# Copy this to .env and fill in your values

APP_ENV=development
PORT=8080

# PostgreSQL
# For Supabase later: replace this single DATABASE_URL with your Supabase Postgres URL.
DATABASE_URL=postgres://nyay:nyay_secret@localhost:5432/nyaydb?sslmode=disable
POSTGRES_PASSWORD=nyay_secret

# Redis
REDIS_URL=redis://localhost:6379/0

# Meilisearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=masterKey

# Auth — CHANGE THESE IN PRODUCTION
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_ACCESS_EXP=15m
JWT_REFRESH_EXP=168h

# CORS
ALLOWED_ORIGINS=http://localhost:8081,exp://192.168.1.x:8081
